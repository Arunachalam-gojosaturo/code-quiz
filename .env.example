# Required for admin console login. Set this in Vercel → Project Settings → Environment Variables.
ADMIN_SECRET="change-me-to-a-strong-passphrase"

# Optional: Gemini AI hints and evaluation
GEMINI_API_KEY=""

# Optional: Groq Llama evaluation and hints
GROQ_API_KEY=""

# Optional: Telegram proctor alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_URL=""

# Optional: Upstash Redis for persistent leaderboard/reports on Vercel (recommended for production)
# Create a free database at https://upstash.com then paste REST credentials here.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Local server port (Vercel ignores this)
PORT="3000"
